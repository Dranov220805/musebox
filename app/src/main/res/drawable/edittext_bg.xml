<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Transparent background -->
    <solid android:color="@android:color/transparent" />

    <!-- Green border -->
    <stroke
        android:width="2dp"
        android:color="@color/musebox_green" />

    <!-- Rounded corners -->
    <corners android:radius="8dp" />

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp" />
</shape>