<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="@dimen/player_padding">

    <!-- Close/Minimize Button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="@dimen/button_size_medium"
        android:layout_height="@dimen/button_size_medium"
        android:src="@drawable/ic_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Close" />

    <!-- Centered content container for better tablet layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintWidth_max="@dimen/max_content_width"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/imgAlbumArt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/album_art_margin_top"
            android:src="@drawable/ic_music_note"
            android:background="@drawable/circle_background"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.25"
            android:contentDescription="Album Art" />

        <!-- Song Title -->
        <TextView
            android:id="@+id/txtFullSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_top"
            android:text="Song Title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/imgAlbumArt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Artist Name -->
        <TextView
            android:id="@+id/txtFullArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Artist Name"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_size_artist"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtFullSongTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Progress SeekBar -->
        <SeekBar
            android:id="@+id/seekBarProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_top"
            android:progressTint="@color/white"
            android:thumbTint="@color/white"
            android:progressBackgroundTint="@color/gray"
            app:layout_constraintTop_toBottomOf="@id/txtFullArtist"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Time Labels -->
        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/gray"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/seekBarProgress"
            app:layout_constraintStart_toStartOf="@id/seekBarProgress" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/gray"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/seekBarProgress"
            app:layout_constraintEnd_toEndOf="@id/seekBarProgress" />

        <!-- Volume Control -->
        <LinearLayout
            android:id="@+id/volumeControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/txtCurrentTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVolumeToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_volume_up"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:contentDescription="Mute/Unmute" />

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="70"
                android:progressTint="@color/white"
                android:thumbTint="@color/white"
                android:progressBackgroundTint="@color/gray" />

            <TextView
                android:id="@+id/txtVolumeLevel"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Skip/Seek Controls -->
        <LinearLayout
            android:id="@+id/skipControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/volumeControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnSkipBackward"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_skip_backward"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:contentDescription="Skip backward 10s" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:text="10s"
                android:textColor="@color/gray"
                android:textSize="10sp" />

            <ImageButton
                android:id="@+id/btnSkipForward"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_skip_forward"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:contentDescription="Skip forward 10s" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:text="Speed:"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerPlaybackSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_bg"
                android:popupBackground="@color/dark_gray" />

        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:id="@+id/playbackControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/skipControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Shuffle Button -->
            <ImageButton
                android:id="@+id/btnFullShuffle"
                android:layout_width="@dimen/button_size_small"
                android:layout_height="@dimen/button_size_small"
                android:src="@drawable/ic_shuffle"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/gray"
                android:contentDescription="Shuffle" />

            <!-- Previous Button -->
            <ImageButton
                android:id="@+id/btnFullPrevious"
                android:layout_width="@dimen/button_size_medium"
                android:layout_height="@dimen/button_size_medium"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_skip_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:contentDescription="Previous" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btnFullPlayPause"
                android:layout_width="@dimen/button_size_large"
                android:layout_height="@dimen/button_size_large"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/circle_background"
                app:tint="@color/white"
                android:contentDescription="Play/Pause" />

            <!-- Next Button -->
            <ImageButton
                android:id="@+id/btnFullNext"
                android:layout_width="@dimen/button_size_medium"
                android:layout_height="@dimen/button_size_medium"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_skip_next"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:contentDescription="Next" />

            <!-- Repeat Button -->
            <ImageButton
                android:id="@+id/btnFullRepeat"
                android:layout_width="@dimen/button_size_small"
                android:layout_height="@dimen/button_size_small"
                android:src="@drawable/ic_repeat_all"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/gray"
                android:contentDescription="Repeat" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>