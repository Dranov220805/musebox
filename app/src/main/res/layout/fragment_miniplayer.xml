<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/dark_gray"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Album Art (smaller) -->
    <ImageView
        android:id="@+id/imgSongArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/circle_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="@string/album_art" />

    <!-- Song Info Container -->
    <LinearLayout
        android:id="@+id/songInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgSongArt"
        android:layout_toStartOf="@id/controlsContainer"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!-- Song Title -->
        <TextView
            android:id="@+id/txtSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollHorizontally="true" />

        <!-- Artist Name -->
        <TextView
            android:id="@+id/txtArtistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Artist Name"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Playback Controls Container -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Circular Progress + Play/Pause Button -->
        <FrameLayout
            android:id="@+id/btnPlayPauseContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp">

            <!-- Circular Progress (smaller) -->
            <com.example.musebox.views.CircularProgressView
                android:id="@+id/circularProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:progress="0"
                app:progressColor="@color/musebox_green"
                app:strokeWidth="3dp"
                app:trackColor="@color/gray" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                app:tint="@color/white"
                android:contentDescription="@string/play_pause" />
        </FrameLayout>

        <!-- Queue Button -->
        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_queue_music"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/gray"
            android:contentDescription="Open Queue" />
    </LinearLayout>

</RelativeLayout>

