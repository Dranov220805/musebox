<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MuseBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Spotify Dark Theme -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="colorSecondaryVariant">@color/spotify_green_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/spotify_black</item>
        <item name="colorSurface">@color/spotify_dark_gray</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- action bar disabled -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/spotify_black</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/spotify_black</item>
        
        <!-- Popup Menu Style -->
        <item name="popupMenuStyle">@style/Widget.MuseBox.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.MuseBox.PopupMenu</item>
    </style>
    
    <!-- Custom Popup Menu Style -->
    <style name="Widget.MuseBox.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    
    <!-- Menu Text Appearance -->
    <style name="TextAppearance.MuseBox.Menu" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>